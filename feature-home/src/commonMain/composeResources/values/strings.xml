<resources>
    <!--
      Home and onboarding copy, resolved by Compose Multiplatform resources rather
      than by each host. `HomeImportOnboardingPolicy` and `HomeTextCopy` in :core do
      the same job by branching on `Locale.getDefault().language`, which is a JVM API
      this module cannot reach and a mechanism that does not extend past two
      languages. The English and Japanese wording is carried over from them so the
      Android host's visible behavior is unchanged.

      Where the wording had to change it is because it named AnkiDroid or an Android
      runtime permission, neither of which exists on a host talking to Anki over
      AnkiConnect. Those lines are generic here, and the host supplies the specific
      sentence through `HostOnboardingCopy` — which is why the two shipped Android
      strings appear verbatim in the Android host's own resources rather than here.
    -->

    <!--
      One body and one button label per OnboardingStep. `onboarding_connect_body`
      and `onboarding_authorize_body` are the generic fallbacks: both hosts override
      them, because "install AnkiDroid" and "start Anki" are different instructions
      for the same state.
    -->
    <string name="onboarding_connect_body">Connect a collection, then come back to sync your kanji.</string>
    <string name="onboarding_connect_action">Connect collection</string>

    <string name="onboarding_authorize_body">Kani needs permission to read your collection. Data stays on your device.</string>
    <string name="onboarding_authorize_action">Grant access</string>

    <string name="onboarding_choose_source_body">Choose import sources before you sync.</string>
    <string name="onboarding_choose_source_action">Review import settings</string>

    <string name="onboarding_ready_action">Sync cards</string>

    <string name="onboarding_recover_authorization_body">Kani couldn't read your collection because access was refused. Grant access, then try syncing again.</string>
    <string name="onboarding_recover_authorization_action">Fix access</string>

    <string name="onboarding_recover_sync_body">Last sync failed: %1$s. Check source settings, then try again.</string>
    <string name="onboarding_recover_sync_action">Try sync again</string>

    <string name="onboarding_synced_action">Sync again</string>

    <!--
      The synced summary. Split into a plural count line and a configuration line
      because the count needs plural selection and the configuration line does not,
      and because the configuration line is reused verbatim by the sync
      confirmation.
    -->
    <plurals name="onboarding_synced_body">
        <item quantity="one">Last sync imported %1$d kanji.</item>
        <item quantity="other">Last sync imported %1$d kanji.</item>
    </plurals>
    <string name="onboarding_source_and_model">Note type %1$s. Sources: %2$s.</string>
    <string name="onboarding_source_query">Query: %1$s.</string>
    <string name="onboarding_source_none">none</string>

    <string name="import_source_active_cards">active cards</string>
    <string name="import_source_suspended_cards">suspended cards</string>
    <string name="import_source_tagged_cards">tagged cards</string>
    <string name="import_source_weak_cards">weak cards</string>
    <string name="import_source_browser_query">browser query</string>

    <!--
      The repaired-note tag write-back line. Stating the count is what makes the
      write manual-confirm-only rather than a silent side effect of syncing, so it
      appears on the onboarding body and again in the confirmation.
    -->
    <plurals name="onboarding_repaired_tagging">
        <item quantity="one">This sync will also tag %1$d repaired kanji in your collection.</item>
        <item quantity="other">This sync will also tag %1$d repaired kanji in your collection.</item>
    </plurals>

    <!-- The sync failure body when the provider gave no reason of its own. -->
    <string name="sync_failure_fallback">Check collection access, then retry.</string>

    <!-- The manual sync confirmation. Nothing syncs until this is answered. -->
    <string name="sync_confirm_title">Sync collection</string>
    <string name="sync_confirm_body">Kani keeps suspended %1$s cards on device. Turn on active cards if you want those too.</string>
    <string name="sync_confirm_action">Sync cards</string>
    <string name="sync_cancel">Cancel</string>

    <!-- Sync progress. Cancellation keeps whatever already committed. -->
    <string name="sync_in_progress_title">Syncing collection</string>
    <string name="sync_cancel_action">Stop sync</string>
    <string name="sync_already_running">A sync is already running.</string>

    <!--
      Note type and field configuration. One label per FieldRole, plus the two
      problems a mapping can have: a role never picked, and a role whose field was
      renamed in Anki after Kani was configured.
    -->
    <string name="note_type_title">Note type</string>
    <string name="note_type_label">%1$s (%2$s)</string>
    <plurals name="note_type_field_count">
        <item quantity="one">%1$d field</item>
        <item quantity="other">%1$d fields</item>
    </plurals>
    <string name="note_type_too_few_fields">This note type has too few fields for Kani to import from.</string>

    <string name="field_role_expression">Word</string>
    <string name="field_role_reading">Reading</string>
    <string name="field_role_meaning">Meaning</string>
    <string name="field_role_sentence">Example sentence</string>
    <string name="field_role_frequency">Frequency</string>
    <string name="field_role_frequency_sort">Frequency sort</string>

    <string name="field_role_required">Required</string>
    <string name="field_role_optional">Optional</string>
    <string name="field_unmapped">Not set</string>
    <string name="field_missing_required">Choose a field for %1$s before syncing.</string>
    <string name="field_stale">%1$s points at a field this note type no longer has.</string>

    <!-- Provider status, shown above onboarding so the state is never implicit. -->
    <string name="provider_status_title">Collection</string>
    <string name="provider_status_absent">Not connected</string>
    <string name="provider_status_unauthorized">Access needed</string>
    <string name="provider_status_ready">Connected</string>

    <!--
      Repaired-card handoff. The copy hands the user a search to paste into Anki
      rather than unsuspending anything: Kani never writes card queue state.
    -->
    <string name="repaired_handoff_title">Repaired kanji</string>
    <plurals name="repaired_handoff_body">
        <item quantity="one">%1$d repaired kanji is tagged in your collection. Search for it there to unsuspend the cards.</item>
        <item quantity="other">%1$d repaired kanji are tagged in your collection. Search for them there to unsuspend the cards.</item>
    </plurals>
    <string name="repaired_handoff_query">tag:kani_repaired is:suspended</string>
    <string name="repaired_handoff_copy">Copy search</string>
    <string name="repaired_handoff_copied">Search copied.</string>

    <!--
      The Home dashboard. Wording carried over from `HomeTextCopy` in :core, except
      where it named AnkiDroid: the primary action there read "Sync AnkiDroid", which
      is wrong on a host talking to Anki over AnkiConnect, so it is "Sync collection"
      here. The Android host keeps its own string for its own screens; this is the
      shared surface.
    -->
    <string name="home_title">Kani</string>
    <string name="home_metric_sync">Sync</string>
    <string name="home_metric_streak">Streak</string>
    <string name="home_metric_focus">Focus</string>
    <string name="home_metric_card_description">Home metric card</string>

    <string name="home_sync_action">Sync collection</string>
    <string name="home_study_action">Study now</string>
    <plurals name="home_study_remaining">
        <item quantity="one">%1$d to study</item>
        <item quantity="other">%1$d to study</item>
    </plurals>

    <string name="home_today_title">Today</string>
    <string name="home_deck_overview_title">Deck overview</string>

    <!--
      The focus queue, and the two reasons it can be empty. They are separate strings
      because the remedy differs: an empty collection needs a sync, and a full
      collection with nothing active needs a study session.
    -->
    <string name="focus_queue_title">Focus queue</string>
    <string name="focus_queue_view_all">View all</string>
    <string name="focus_queue_nothing_imported_title">No kanji queued</string>
    <string name="focus_queue_nothing_imported_body">Sync your collection to load your kanji queue.</string>
    <string name="focus_queue_nothing_active_title">No active practice yet</string>
    <string name="focus_queue_nothing_active_body">Study now adds the next kanji.</string>
    <string name="focus_queue_card_description">Study card for %1$s, %2$s</string>

    <!--
      Browse. `browse_result_truncated` reports a capped result set rather than
      letting the row count imply it, because a user who searched for something with
      more matches than the cap needs to know the list is not the whole answer.
    -->
    <string name="browse_title">Browse Kanji</string>
    <string name="browse_search_hint">Search kanji, meaning, reading, or examples</string>
    <string name="browse_search_action">Search</string>
    <string name="browse_similar_filter">Similar kanji only</string>
    <string name="browse_show_suspended">Show suspended</string>
    <string name="browse_result_none">No matches</string>
    <string name="browse_result_truncated">Showing first %1$d matches</string>
    <plurals name="browse_result_count">
        <item quantity="one">%1$d kanji</item>
        <item quantity="other">%1$d kanji</item>
    </plurals>
    <string name="browse_selection_none">None selected</string>
    <string name="browse_selection_all">All selected</string>
    <string name="browse_selection_partial">%1$d of %2$d selected</string>
    <string name="browse_select_all">Select all</string>
    <string name="browse_deselect_all">Clear all</string>
    <string name="browse_studied_toggle">Study %1$s</string>
    <string name="browse_row_description">Open details for %1$s</string>
    <string name="browse_suspended_chip">SUSPENDED</string>
    <string name="browse_row_selected">selected</string>
    <string name="browse_row_not_selected">not selected</string>
    <string name="browse_empty_title">No local kanji found</string>
    <string name="browse_empty_body">Sync your collection first, or try a different search.</string>

    <!--
      A host limitation Home explains rather than hides. AnkiConnect does not
      advertise FSRS memory state, so admission seeds maturity from the card's
      interval instead — which changes how the first reviews are scheduled without
      disabling anything, so saying so is the only correct response.
    -->
    <string name="notice_reduced_fsrs_title">Reduced scheduling precision</string>
    <string name="notice_reduced_fsrs_body">This collection doesn't report FSRS memory state, so Kani estimates it from each card's interval. Your first reviews may be scheduled a little differently.</string>
</resources>
