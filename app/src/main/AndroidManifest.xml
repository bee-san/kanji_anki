<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"
        tools:ignore="ProtectedPermissions"
        tools:targetApi="s" />
    <application
        android:name=".KaniApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:resizeableActivity="true"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme"
        tools:targetApi="tiramisu">
        <!--
            The thin shared-graph host (Goal 199) is now the launcher. It owns the four
            host responsibilities and hands navigation, content, and effects to the shared
            graph both hosts run.

            singleTop is load-bearing and not stylistic: every deep link into the app —
            reminder notification, widget tap, launcher shortcut — is delivered to the
            running instance through onNewIntent, and without it each one would stack a
            second copy of the app over the first.

            The shortcuts meta-data stays on whichever activity is the launcher, because
            that is where the system reads the static shortcut definitions from.
        -->
        <activity
            android:name=".host.KaniHostActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!--
            The pre-Goal-199 host, kept declared but no longer the entry point while its
            ~170-file inheritance chain is removed in its own commit. Not exported: nothing
            outside the app may start it, and nothing inside does either now that the
            notification/widget/shortcut intents name the host above.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />
        <!--
            Kani initializes scheduler/update work explicitly from MainActivityStartup,
            and does not use AndroidX Startup consumers. Removing the provider keeps
            transitive EmojiCompat/ProcessLifecycle/ProfileInstaller initializers out
            of the cold activity-start path.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />
        <!--
            FileProvider so the Settings "Share debug log" actions can hand narrowly scoped cache
            snapshots to the Android share sheet. The live internal files directory is not exposed.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.debuglog"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/debug_log_paths" />
        </provider>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.missingkanji"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/missing_kanji_export_paths" />
        </provider>
        <service
            android:name=".sync.AutoSyncJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />
        <!--
            Exported because pre-Android-12 launcher hosts start the configure
            activity directly with startActivityForResult instead of the
            system IntentSender grant. The activity validates the appWidgetId
            extra and finishes immediately when it is missing.
        -->
        <activity
            android:name=".widget.KaniWidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".widget.KaniWidgetReceiver"
            android:exported="false"
            android:label="@string/study_overview_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kani_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.QuickStudyWidgetReceiver"
            android:exported="false"
            android:label="@string/quick_study_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_study_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.ActivityWidgetReceiver"
            android:exported="false"
            android:label="@string/activity_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/activity_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.FocusKanjiWidgetReceiver"
            android:exported="false"
            android:label="@string/focus_kanji_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/focus_kanji_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.KaniWidgetRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.bee.kanjianki.widget.action.REFRESH" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".update.PackageInstallStatusReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.BootReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
