<?xml version="1.0" encoding="utf-8"?>
<!--
    Static widget-picker preview (previewLayout, API 31+). Mirrors the DUE_NOW
    card in the default girlypop palette; the live widget renders through
    Glance with the user's theme.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7FB"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp"
    tools:ignore="Overdraw">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#D32F73"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/kani_widget_preview_count"
        android:textColor="#2D1635"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/kani_widget_preview_streak"
        android:textColor="#6C5674"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/shortcut_study_long_label"
        android:textColor="#D32F73"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
